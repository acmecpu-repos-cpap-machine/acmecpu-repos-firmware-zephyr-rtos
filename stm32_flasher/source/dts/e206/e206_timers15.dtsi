&timers15 {
	status = "okay";
   	st,prescaler = <239>;	/* The counter clock frequency (CK_CNT) is equal to fCK_PSC / (PSC[15:0] + 1). */
	
	uvc1_pwm: pwm {
		status = "okay";
    	pinctrl-0 = <&tim15_ch1_pe5>;
    	pinctrl-names = "default";
	};

	uvc2_pwm: pwm {
		status = "okay";
    	pinctrl-0 = <&tim15_ch2_pe6>;
    	pinctrl-names = "default";
	};
};
