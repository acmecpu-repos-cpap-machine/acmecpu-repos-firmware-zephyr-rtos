/*
 * Copyright (c) 2022 Acme CPU
 *
 * C204 I2C2 bus has
 *		- S201 PCB (2 x bmp388)
 *		- eeprom 24aa00t 
 */


&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pf6 &i2c2_sda_pa8>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
/*
  compatible = "st,stm32-i2c-dma-v2";
  dmas = <&dma1 0 0 0x0 0x0>,
	 <&dma1 0 0 0x0 0x0>;
  dma-names = "tx","rx";
  dma-label-tx = "DMA_TX_I2C_3";
  dma-label-rx = "DMA_RX_I2C_3";
*/

	p121_ps: bmp388@76 {
		compatible = "bosch,bmp388";
    	reg = <0x76>;
    	label = "PS_INT_POS";
    	odr = "25";			/* data rate = 25Hz */
    	osr-press = <1>;	/* pressure oversampling = No */
    	osr-temp = <1>;		/* temperature oversampling = No */
    	iir-filter = <0>;	/* iir filter = default val */
	};

	p122_ps: bmp388@77 {
    	compatible = "bosch,bmp388";
    	reg = <0x77>;
    	label = "PS_INT_NEG";
    	odr = "25";			/* data rate = 25Hz */
    	osr-press = <1>;	/* pressure oversampling = No */
    	osr-temp = <1>;		/* temperature oversampling = No */
    	iir-filter = <0>;	/* iir filter = default val */
	};

	p105_eeprom: 24aa00t@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		label = "EEPROM";
		size = <16>;
		pagesize = <1>;
		address-width = <8>;
		timeout = <10>;
	};
};
