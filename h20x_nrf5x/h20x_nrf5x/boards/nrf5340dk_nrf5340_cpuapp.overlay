&i2c1 {
	sh_oxh: shmax30101@55 {
		compatible = "maxim,shmax30101";
		reg = <0x55>;
    	reset-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
    	mfio-gpios = <&gpio1 0 0>;
		label = "SH_MAXIM";
	};
};
