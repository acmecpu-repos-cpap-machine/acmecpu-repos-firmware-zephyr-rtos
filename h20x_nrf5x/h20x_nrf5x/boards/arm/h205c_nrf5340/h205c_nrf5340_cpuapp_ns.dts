/dts-v1/;
#include <nordic/nrf5340_cpuappns_qkaa.dtsi>
#include "h205c_nrf5340_cpuapp_common.dts"

#include "h205c_nrf5340/h205c_nrf5340.dtsi"

/ {
	model = "AcmeCPU H205C NRF5340 NS Application";
	compatible = "acpu,h205c-nrf5340-cpuapp";

	chosen {
		zephyr,sram = &sram0_ns;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_ns_partition;
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};
