# Configurations for m2m frame library 

menuconfig LIB_M2M_FRAME
	bool "M2m frame library"
	default y
	help
	  Enable or disable the M2m frame library 

if LIB_M2M_FRAME
	config LIB_M2M_FRAME_BUFFER_SIZE_MAX
		int "Maximum size of the frame buffer used for transmission"
		range 32 102400
		default 512
		help
			Maximum size of the frame buffer used for transmission

	config LIB_M2M_FRAME_ACK_TIMEOUT_MS
		int "Timeout in ms for the sender to wait for acknowledgment before re-transmission"
		range 10 60000
		default 2000
		help
			Timeout in ms for the sender to wait for acknowledgment before re-transmission

	config LIB_M2M_FRAME_RETRY_COUNT_MAX
		int "Maximum number of times a packet re-transmission should be tried"
		range 1 1000
		default 10
		help
			Maximum number of times a packet re-transmission should be tried

endif # LIB_M2M_FRAME
