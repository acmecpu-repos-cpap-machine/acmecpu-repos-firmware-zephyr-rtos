# OLED display configurations


config APP_DISPLAY_HEIGHT_PX
	int "Display height in pixels"
	range 1 4000
	default 64
	help
		Display height in pixels
		
config APP_DISPLAY_WIDTH_PX
	int "Display width in pixels"
	range 1 4000
	default 128
	help
		Display width in pixels
		
config APP_DISPLAY_STATUSBAR_HEIGHT_PX
	int "Statusbar height in pixels"
	range 1 4000
	default 10
	help
		Display width in pixels
		
