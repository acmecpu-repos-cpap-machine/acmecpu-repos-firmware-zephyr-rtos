/*
 * Copyright (c) 2023 Acme CPU
 *
 * E206 I2C4 bus has
 *		- S201 PCB (2 x bmp388)
 */

 &i2c4 {
 	status = "okay";
	pinctrl-0 = <&i2c4_scl_ph11 &i2c4_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	p121_ps_ext: bmp388@76 {
    	compatible = "bosch,bmp388";
    	reg = <0x76>;
    	label = "PS_EXT_POS";
    	odr = "25";			/* data rate = 25Hz */
   		osr-press = <1>;	/* pressure oversampling = No */
    	osr-temp = <1>;		/* temperature oversampling = No */
    	iir-filter = <0>;	/* iir filter = default val */
	};

	p122_ps_ext: bmp388@77 {
    	compatible = "bosch,bmp388";
    	reg = <0x77>;
    	label = "PS_EXT_NEG";
    	odr = "25";			/* data rate = 25Hz */
    	osr-press = <1>;	/* pressure oversampling = No */
    	osr-temp = <1>;		/* temperature oversampling = No */
    	iir-filter = <0>;	/* iir filter = default val */
	};
};