/*
 * Copyright (c) 2024 Acme CPU
 * 
 * GPIO device list
 *  - audio ps enable
 * 	- network processor (esp32) reset and wakeup
 *  - bldc driver reset and boot
 *  - usb mux (TS3USB221ERSER)
 *  - heater
 *	- USB PD (device)
 * 	- other gpios
 */
 
 / {
 	aux_enable {
		compatible = "gpio-keys";

	    audio_ps_en: audio_ps_en {
	      gpios = <&gpioh 13 (GPIO_PUSH_PULL)>;
	    };
	};
	
	net_proc_gpios {
		compatible = "gpio-keys";
		
	    wifibt_rst: wifibt_rst {
	      gpios = <&gpiof 8 (GPIO_PUSH_PULL)>;
	    };
	    
	    wifibt_wake: wifibt_wake {
	      gpios = <&gpiof 5 (GPIO_PUSH_PULL)>;
	    };
	};
	
	bldc_drv_gpios {
		compatible = "gpio-keys";
		
	    bldc_rst: bldc_rst {
	      gpios = <&gpioh 12 (GPIO_PUSH_PULL)>;
	    };
	    
	    bldc_boot: bldc_boot {
	      gpios = <&gpioh 10 (GPIO_PUSH_PULL)>;
	    };
	};

	i2c_switch_gpios {
		compatible = "gpio-keys";

	    ts3usb221_sel: ts3usb221_sel {
	      gpios = <&gpioc 2 (GPIO_PUSH_PULL)>;
	    };

	    ts3usb221_oe: ts3usb221_oe {
	      gpios = <&gpioc 3 (GPIO_PUSH_PULL)>;
	    };
	};
	
	heating_module_gpios {
		compatible = "gpio-keys";
		
	    hm1_24w_en: hm1_24w_en {
	      gpios = <&gpioi 10 (GPIO_PUSH_PULL)>;
	    };

	    hm1_12w_en: hm1_12w_en {
	      gpios = <&gpioi 5 (GPIO_PUSH_PULL)>;
	    };		
	    
	    hm_usb_en: hm_usb_en {
	      gpios = <&gpioc 4 (GPIO_PUSH_PULL)>;
	    };

	    hm_bat_en: hm_bat_en {
	      gpios = <&gpioc 1 (GPIO_PUSH_PULL)>;
	    };	
	};
	
	ucpd_ctrl_gpios {	/* use if i2c driver is not available */
		compatible = "gpio-keys";
		
	    ucpd_rst: ucpd_rst {
	      gpios = <&gpioc 7 (GPIO_PUSH_PULL)>;
	    };

	    ucpd_alert: ucpd_alert {
	      gpios = <&gpiog 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	    };		

	    ucpd_abside: ucpd_abside {
	      gpios = <&gpiog 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	    };		
	};

	other_gpios {
		compatible = "gpio-keys";

	    cont1: cont1 {
	      gpios = <&gpiod 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	    };
	    
	    cont2: cont2 {
	      gpios = <&gpiod 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	    };
	    
	    vbus_in_sense_en: vbus_in_sense_en {
	      gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
	    };

	    vbat_sense_en: vbat_sense_en {
	      gpios = <&gpiof 13 GPIO_ACTIVE_HIGH>;
	    };
	};
};



